<?xml version="1.0"?>
<sdf version="1.9">

  <world name="omokai_world">

    <!-- Physics -->
    <physics name="default_physics" type="ode">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
    </physics>

    <!-- Gravity -->
    <gravity>0 0 -9.81</gravity>

    <!-- Ground -->
    <model name="ground">

      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </visual>

      </link>

    </model>

    <!-- Light -->
    <light
      name="sun"
      type="directional">

      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>

      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>

      <direction>-0.5 0.5 -1</direction>

    </light>

    <!-- OMOKAI robot -->
    <include>
      <uri>model://vehicle_blue</uri>
      <name>vehicle_blue</name>
      <pose>0 0 0.15 0 0 0</pose>
    </include>

  </world>

</sdf>
